###############################################################################
# SenseWay Backend — ready-to-run requests
#
# Open this in VS Code with the "REST Client" extension (humao.rest-client) or
# JetBrains' built-in HTTP client, and click "Send Request" above each block.
# Or copy the equivalent curl from API-CONTRACT.md.
#
# @host assumes the default port 5000. On macOS, port 5000 is often taken by the
# AirPlay Receiver; if health returns an empty 403, either disable AirPlay
# Receiver (System Settings > General > AirDrop & Handoff) or run the server on
# another port (PORT=5001 npm run dev) and change @host below.
###############################################################################

@host = http://localhost:5000

### Health — liveness only, never touches DB/Google/pipeline
GET {{host}}/api/health

### Legacy welcome route (must still work)
GET {{host}}/

### Routes — happy path (calmest-first; route-2 is fastest AND most crowded)
POST {{host}}/api/routes
Content-Type: application/json

{
  "start":       { "latitude": -37.8136, "longitude": 144.9631 },
  "destination": { "latitude": -37.8183, "longitude": 144.9671 },
  "departureTime": "2026-08-06T08:15:00+10:00",
  "preferences": { "avoidHighDensity": true, "crowdThreshold": 70 }
}

### Routes — low threshold trips noLowSensoryRouteAvailable + notice
POST {{host}}/api/routes
Content-Type: application/json

{
  "start":       { "latitude": -37.8136, "longitude": 144.9631 },
  "destination": { "latitude": -37.8183, "longitude": 144.9671 },
  "preferences": { "avoidHighDensity": true, "crowdThreshold": 10 }
}

### Routes — minimal body (departureTime + preferences default)
POST {{host}}/api/routes
Content-Type: application/json

{
  "start":       { "latitude": -37.8136, "longitude": 144.9631 },
  "destination": { "latitude": -37.8183, "longitude": 144.9671 }
}

### Reroute — congestion ahead -> recommends a calmer route
POST {{host}}/api/routes/reroute
Content-Type: application/json

{
  "currentLocation": { "latitude": -37.8136, "longitude": 144.9631 },
  "destination":     { "latitude": -37.8183, "longitude": 144.9671 },
  "activeRouteId": "route-2",
  "preferences": { "crowdThreshold": 70 }
}

### Reroute — standing on the destination -> nothing ahead, no reroute
POST {{host}}/api/routes/reroute
Content-Type: application/json

{
  "currentLocation": { "latitude": -37.8183, "longitude": 144.9671 },
  "destination":     { "latitude": -37.8183, "longitude": 144.9671 },
  "activeRouteId": "route-2",
  "preferences": { "crowdThreshold": 70 }
}

### Refuges — 8 walking minutes (radius 640m)
GET {{host}}/api/refuges/nearby?latitude=-37.8100&longitude=144.9660&walkingMinutes=8

### Refuges — 5 walking minutes (radius 400m)
GET {{host}}/api/refuges/nearby?latitude=-37.8136&longitude=144.9631&walkingMinutes=5

### Forecast — 15-minute intervals across 2 hours
GET {{host}}/api/forecast?latitude=-37.8136&longitude=144.9631&departureTime=2026-08-06T08:15:00%2B10:00&hours=2

###############################################################################
# Failure cases
###############################################################################

### 400 INVALID_REQUEST — missing destination (details lists the problem)
POST {{host}}/api/routes
Content-Type: application/json

{
  "start": { "latitude": -37.8136, "longitude": 144.9631 }
}

### 400 INVALID_REQUEST — latitude out of range (999)
POST {{host}}/api/routes
Content-Type: application/json

{
  "start":       { "latitude": 999, "longitude": 144.9631 },
  "destination": { "latitude": -37.8183, "longitude": 144.9671 }
}

### 400 INVALID_REQUEST — coordinates outside greater Melbourne (London)
POST {{host}}/api/routes
Content-Type: application/json

{
  "start":       { "latitude": 51.5074, "longitude": -0.1278 },
  "destination": { "latitude": -37.8183, "longitude": 144.9671 }
}

### 400 MALFORMED_JSON — body is not valid JSON
POST {{host}}/api/routes
Content-Type: application/json

{ this is not valid json

### 400 INVALID_REQUEST — POST with no body at all (must not crash)
POST {{host}}/api/routes

### 400 INVALID_REQUEST — refuges without coordinates
GET {{host}}/api/refuges/nearby?walkingMinutes=5

### 404 NOT_FOUND — unknown endpoint returns JSON, not HTML
GET {{host}}/api/does-not-exist
