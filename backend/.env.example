PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=senseway
DB_USER=postgres
DB_PASSWORD=our_password

GOOGLE_MAPS_API_KEY= google_maps_api_key

# --- Added for the backend API foundation (all optional; absence = mock mode) ---

# senseway-data-pipeline base URL for the /refuge/nearby call. When absent, the
# refuge finder falls back to mock refuges. Local example: http://localhost:8080
# Deployed: the Cloud Run URL (ask the team).
PIPELINE_URL=

# Comma-separated list of browser origins allowed by CORS. Defaults to the local
# Vite dev server when unset. Add the deployed frontend origin here for prod.
CORS_ORIGINS=http://localhost:5173

# Optional timeouts (milliseconds) and DB connect timeout. Sensible defaults are
# used when unset; you normally do not need to set these.
GOOGLE_TIMEOUT_MS=4000
PIPELINE_TIMEOUT_MS=4000
DB_CONNECTION_TIMEOUT_MS=2000